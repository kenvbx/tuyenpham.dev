{
  "name": "@cms/tooling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:dry-run": "node scripts/migrate.mjs --dry-run",
    "db:seed": "node scripts/seed.mjs",
    "db:seed:dry-run": "node scripts/seed.mjs --dry-run",
    "lint": "eslint . --ext .js,.mjs,.ts",
    "typecheck": "node -e \"console.log('tooling typecheck placeholder')\"",
    "test": "node scripts/migrate.mjs --dry-run && node scripts/seed.mjs --dry-run",
    "format": "prettier --write ."
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.23.0"
  }
}
