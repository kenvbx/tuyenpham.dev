{
  "name": "tuyenpham-cms",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @cms/admin --filter @cms/api dev",
    "dev:admin": "pnpm --filter @cms/admin dev",
    "dev:api": "pnpm --filter @cms/api dev",
    "build": "pnpm -r --if-present build",
    "build:admin": "pnpm --filter @cms/admin build",
    "build:api": "pnpm --filter @cms/api build",
    "lint": "eslint . --ext .js,.mjs,.ts,.tsx",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @cms/tooling db:migrate",
    "db:seed": "pnpm --filter @cms/tooling db:seed"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
